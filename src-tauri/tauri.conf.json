{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Library Studio KH",
  "version": "0.7.26",
  "identifier": "app.librarystudiokh.desktop",
  "build": {
    "frontendDist": "../ui-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "externalBin": [
      "binaries/library-studio-server"
    ],
    "resources": [
      "helper/Library Studio KH Helper.app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "KH Studio Local Signing"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
