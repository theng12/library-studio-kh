<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime turns on library validation. This app and its vendored Sparkle.framework are
       both self-signed with "KH Studio Local Signing" and carry no Team ID, so dyld reads them as
       different teams and aborts at launch: "mapping process and mapped file have different Team IDs".
       This entitlement switches that one check off for our own pair; every other hardened-runtime
       protection stays on. Displays 0.1.8 died on exactly this with a green gate. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
